+/// Session facts received from the server, without executing observation SQL.
+#[derive(Debug, Clone, Copy)]
+pub struct SessionState<'a> {
+    /// The latest database ENVCHANGE value. Login aliases need not be canonical.
+    pub database: &'a str,
+    /// Whether the server has an outstanding transaction descriptor.
+    /// Nesting depth and committability are not supplied by this protocol state.
+    pub has_transaction: bool,
+    /// The session identifier from the server's response packet header.
+    pub server_process_id: u16,
+    /// Major version, minor version, and build from LOGINACK.
+    pub server_version: (u8, u8, u16),
+}
+
 impl<S: AsyncRead + AsyncWrite + Unpin + Send> Client<S> {
+    /// Reads protocol observations after login or a fully consumed response.
+    ///
+    /// This method sends no request. It fails when a response is incomplete or
+    /// the server used a transaction environment change this driver cannot track.
+    /// It does not make an abandoned or cancelled client safe to reuse.
+    pub fn session_state(&self) -> crate::Result<SessionState<'_>> {
+        let context = self.connection.context();
+        if !self.connection.is_eof() || !context.session_state_observable {
+            return Err(crate::Error::Protocol(
+                "session state is unavailable after an incomplete response or unsupported transaction environment change".into(),
+            ));
+        }
+        let missing = || crate::Error::Protocol("server did not supply session login information".into());
+        Ok(SessionState {
+            database: context.database.as_deref().ok_or_else(missing)?,
+            has_transaction: context.transaction_descriptor() != [0; 8],
+            server_process_id: context.server_process_id.ok_or_else(missing)?,
+            server_version: context.server_version.ok_or_else(missing)?,
+        })
+    }
+
